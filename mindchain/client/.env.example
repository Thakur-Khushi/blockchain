# Only VITE_* variables are exposed to the browser — never put secrets here.
# Base path of the REST API (the Vite dev server proxies /api to API_PROXY_TARGET).
VITE_API_URL=/api
# RPC URL MetaMask should use when adding the local Hardhat network.
VITE_RPC_URL=http://127.0.0.1:8545

# Dev-server only (not exposed to the browser)
API_PROXY_TARGET=http://localhost:5000
