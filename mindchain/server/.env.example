# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/mindchain

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# AES-256-GCM key for wellness records: 32 random bytes as 64 hex characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key makes existing records unreadable. In production use a KMS/HSM instead.
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1
# Retired keys kept only to decrypt older records during rotation, e.g. 1:<hex>,2:<hex>
ENCRYPTION_PREVIOUS_KEYS=

# Blockchain (read-only access; the server never stores a wallet private key)
RPC_URL=http://127.0.0.1:8545
RPC_TIMEOUT_MS=5000
# Written by `npm run deploy:local` in /blockchain
DEPLOYMENT_FILE=src/config/deployment.json
# Optional overrides for the deployment file
CONTRACT_ADDRESS=
CHAIN_ID=
WALLET_NONCE_TTL_SECONDS=600

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
BCRYPT_ROUNDS=12

# Used only by `npm run seed:admin`
ADMIN_NAME=MindChain Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
